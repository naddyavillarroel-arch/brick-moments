{
  "expo": {
    "name": "brick-moments",
    "slug": "brick-moments",
    "scheme": "brickmoments",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.namay.brickmoments"
    },
    "android": {
      "package": "com.namay.brickmoments",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD500"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Brick Moments necesita acceder a tus fotos.",
          "cameraPermission": "Brick Moments necesita la cámara para tomar fotos."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Brick Moments guarda copias de tus fotos en el álbum.",
          "photosPermission": "Brick Moments accede a tu galería para crear el álbum."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "46df5ea1-8a47-42ab-a042-6b3b388c07a8"
      }
    }
  }
}
